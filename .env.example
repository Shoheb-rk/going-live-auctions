# Local development uses SQLite when MONGODB_URI is absent.
# For Atlas/Render, set these in the hosting dashboard, not in a committed file.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=going
COOKIE_SECURE=1
PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
